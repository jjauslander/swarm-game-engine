    "benchmark": "tsx tests/benchmark.ts"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
